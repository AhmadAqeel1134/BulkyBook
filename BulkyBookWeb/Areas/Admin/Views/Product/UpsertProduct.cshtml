@using BulkyBook.Models.ViewModels
@model ProductViewModel

<div class="container py-3">
    <a asp-controller="Product" asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back To Products
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>
                @(Model.Product.Id != 0 ? "Edit Product" : "Create Product") 
            </h5>
            <p class="mb-0 small" style="color: #1DB954;">
                @(Model.Product.Id != 0 ? "Edit a Product" : "Add a new Product")
            </p>
        </div>
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data">
                <div class="row">
                <div class="col-lg-8 t">
                    <div asp-validation-summary="ModelOnly" class="text-danger" mb-3></div>
                    <input asp-for="Product.Id" hidden>
                    <input asp-for="Product.ImageUrl" hidden>
                    <div class="row g-3">
                  <div class="col-12">
                        <label asp-for="Product.Title" class="form-label fw-semibold small"></label>
                            <input type="text" asp-for="Product.Title" class="form-control" placeholder="Enter product title" />
                            <span asp-validation-for="Product.Title" class="text-danger small"></span>
                  </div>
                    <div class="col-12">
                            <label asp-for="Product.Description" class="form-label fw-semibold small"></label>
                            <textarea  asp-for="Product.Description" hidden class="form-control" placeholder="Enter product description"></textarea>
                                <div id="quill-editor-des" style="height:200px;"></div>
                            <span asp-validation-for="Product.Description" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Product.ISBN" class="form-label fw-semibold small"></label>
                            <input type="text" asp-for="Product.ISBN" class="form-control" placeholder="Enter product ISBN" />
                        <span asp-validation-for="Product.ISBN" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                            <label asp-for="Product.Author" class="form-label fw-semibold small"></label>
                            <input type="text" asp-for="Product.Author" class="form-control" placeholder="Enter product author" />
                            <span asp-validation-for="Product.Author" class="text-danger small"></span>
                    </div>
                    </div>
                    <div class="border rounded p-3 mt-3 bg-light">
                        <p class="text-uppercase fw-semibold text-secondary mb-3" style="font-size: 0.65rem; letter-spacing: 0.1em;">Pricing</p>
                        <div class ="row g-3">
                    <div class="col-6 col-md-3">
                                <label asp-for="Product.ListPrice" class="form-label fw-semibold small"></label>
                                <input type="text" asp-for="Product.ListPrice" class="form-control" placeholder="Enter product price" />
                                <span asp-validation-for="Product.ListPrice" class="text-danger small"></span>
                    </div>

                            <div class="col-6 col-md-3">
                                <label asp-for="Product.PriceTillFifty" class="form-label fw-semibold small"></label>
                                <input type="text" asp-for="Product.PriceTillFifty" class="form-control" placeholder="Enter product price till 50" />
                                <span asp-validation-for="Product.PriceTillFifty" class="text-danger small"></span>
                    </div>

                    <div class="col-6 col-md-3">
                                <label asp-for="Product.PriceFiftyPlus" class="form-label fw-semibold small"></label>
                                <input type="text" asp-for="Product.PriceFiftyPlus" class="form-control" placeholder="Enter product price for 50 +" />
                                <span asp-validation-for="Product.PriceFiftyPlus" class="text-danger small"></span>
                    </div>

                    <div class="col-6 col-md-3">
                                <label asp-for="Product.PriceHundredPlus" class="form-label fw-semibold small"></label>
                                <input type="text" asp-for="Product.PriceHundredPlus" class="form-control" placeholder="Enter product price for 100+" />
                                <span asp-validation-for="Product.PriceHundredPlus" class="text-danger small"></span>
                    </div>



                        </div>
                    </div>
                     
                    <div class="mt-3">
                        <label asp-for="Product.CategoryId" class="form-label fw-semibold small"></label>
                        <select asp-for="Product.CategoryId" asp-items="@Model.CategoryList" class="form-select">
                        <option disabled selected>--Select Category--</option>
                        </select>
                        <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="mt-3 bg-light">
                        <label class="form-label fw-semibold small">Product Image</label>
                        <div class="border border-2 border-dashed rounded p-4 text-center ">
                            <i class="bi bi-cloud-upload fs-4 text-secondary"></i>
                            <input type="file" name="file" accept="image/*" class="form-control form-control-sm mt-2">
                            <p class="text-secondary mt-1 mb-0" style="font-size:0.75rem;">Upload image for product image (JPG,PNG)</p>
                        </div>
                    </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-accent fw-semibold">
                                @(Model.Product.Id != 0 ? "Edit Product" : "Create Product")
                            </button>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                        </div>
                </div>
                <div class="col-lg-4">
                    <!--image-->
                    @if(!string.IsNullOrEmpty(Model.Product.ImageUrl))
                    {
                    <div class="border rounded p-3 bg-light text-center">
                        <p class="text-uppercase fw-semibold text-secondary mb-2" style="font-size:0.65rem;letter-spacing:0.1rem;">Current Image</p>
                          <img src="@Model.Product.ImageUrl" class="img-fluid rounded shadow-sm mb-2">
                        <p class="text-secondary mb-0" style="font-size:0.75rem;">Upload a new image to replace this one</p>
                    </div>
                    }
                    else
                    {
                    <div class="border rounded p-3 bg-light text-center">
                        <p class="text-uppercase fw-semibold text-secondary mb-2" style="font-size:0.65rem;letter-spacing:0.1rem;">Current Image</p>
                          <i class="bi bi-image" style="font-size: 3rem; color:#94a3b8;"></i>
                         <p class="text-secondary mb-0" style="font-size:0.75rem;">No image</p>
                    </div>
                    }
                    </div>   
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>


    <!-- Initialize Quill editor -->
    <script>
        const quill = new Quill('#quill-editor-des', {
          theme: 'snow'
        });

        const desTextArea=document.querySelector('textarea[name="Product.Description"]');
      
       if(desTextArea.value)
       {
           quill.root.innerHTML=desTextArea.value;
       }

       quill.on('text-change',()=>{
           desTextArea.value=quill.root.innerHTML
       });

    </script>

    @* @{
       await Html.RenderPartialAsync("_ValidationScriptsPartial");
     }  *@  
}
